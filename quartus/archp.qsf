# =============================================================================
# ARCHP Quartus Prime Lite 16.1 project (static prediction: the RANKED build)
# Cyclone V 5CSEMA5F31C6 (DE1-SoC), DEFAULT compiler settings: this file sets
# only the device, the top level, the source files.
# Source list is checked against rtl/ by tests/test_quartus.py.
# =============================================================================
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY processor_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 16.1.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_FILE ../rtl/pkg/archp_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/memory/unified_memory.vhd
set_global_assignment -name VHDL_FILE ../rtl/decode/register_file.vhd
set_global_assignment -name VHDL_FILE ../rtl/decode/control_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/decode/decode_stage.vhd
set_global_assignment -name VHDL_FILE ../rtl/execute/alu.vhd
set_global_assignment -name VHDL_FILE ../rtl/execute/ccr.vhd
set_global_assignment -name VHDL_FILE ../rtl/execute/forwarding_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/execute/ex1_stage.vhd
set_global_assignment -name VHDL_FILE ../rtl/execute/ex2_stage.vhd
set_global_assignment -name VHDL_FILE ../rtl/pipeline/id_ex1_reg.vhd
set_global_assignment -name VHDL_FILE ../rtl/pipeline/ex1_ex2_reg.vhd
set_global_assignment -name VHDL_FILE ../rtl/pipeline/ex2_mem_reg.vhd
set_global_assignment -name VHDL_FILE ../rtl/pipeline/mem_wb_reg.vhd
set_global_assignment -name VHDL_FILE ../rtl/fetch/btb.vhd
set_global_assignment -name VHDL_FILE ../rtl/fetch/fetch_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/core/processor_core.vhd
set_global_assignment -name VHDL_FILE ../rtl/top/processor_top.vhd
